<script>
    function orderCustomPack() {
        const qty = document.getElementById("customQty").value;
        const unit = document.getElementById("customUnit").value;

        if (!qty || qty <= 0) {
            alert("Please enter valid quantity");
            return;
        }

        const message = encodeURIComponent(
            `Hi! I want to order Kolhapuri Kanda Lasun Chutney.\nCustom Quantity: ${qty} ${unit}`
        );

        window.open(
            `https://wa.me/919730395979?text=${message}`,
            "_blank"
        );
    }


        function sendQuickOrder() {
            const name = document.getElementById("qoName").value.trim();
            const phone = document.getElementById("qoPhone").value.trim();
            const pack = document.getElementById("qoPack").value;
            const qty = document.getElementById("qoQty").value;
            const unit = document.getElementById("qoUnit").value;
            const address = document.getElementById("qoAddress").value.trim();

            if (!name || !phone || !address) {
                alert("Please fill Name, Phone, and Address");
                return;
            }

            let orderDetails = "";

            if (pack === "Custom") {
                if (!qty || qty <= 0) {
                    alert("Please enter quantity for Custom Pack");
                    return;
                }
                orderDetails = `Custom Pack: ${qty} ${unit}`;
            } else {
                orderDetails = pack;
            }

            const message = encodeURIComponent(
    `Hi! I want to order Kolhapuri Kanda Lasun Chutney 🌶️

    Name: ${name}
    Phone: ${phone}
    Order: ${orderDetails}
    Address: ${address}`
            );

            window.open(
                `https://wa.me/919730395979?text=${message}`,
                "_blank"
            );
        }


</script>

