@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Lab Application</title>

    <!-- Bootstrap CSS (optional, for responsive layout) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .navbar-brand {
            font-weight: 500;
            color: black;
            margin-left: 15px;
        }
        .signbtn {
            color: black;
            font-weight: 500;
            background-color: aqua;
            margin-right: 10px;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        section {
            display: block;
            width: 100%;
        }

        .container-fluid, .container {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background-color: #e3e3eb">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">SmartLab Manager</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link signbtn border border-dark rounded px-3 py-1" href="@Url.Action("Login","Account")">Sign In</a>
                    </li>
                </ul>
            </div> 
        </div>
    </nav>

    <!-- Main content -->
    <div class="container-fluid">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="text-white pt-5 pb-4" style="background-color: #0b1120;">
        <div class="container text-md-left">
            <div class="row text-md-left">

                <!-- Logo + About -->
                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h6 class="mb-4 fw-bold d-flex align-items-center">
                        <img src="/images/logo.png" alt="Logo" width="32" height="32" class="me-2">
                        LabCollect Diagnostics
                    </h6>
                    <p class="text-white-50">
                        Your trusted partner in accurate medical testing. We provide fast, reliable, and certified
                        laboratory diagnostics for better health decisions.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h6 class="mb-4 fw-bold">Quick Links</h6>
                    <p><a href="#" class="text-white-50 text-decoration-none d-block mb-2">Home</a></p>
                    <p><a href="#" class="text-white-50 text-decoration-none d-block mb-2">Services</a></p>
                    <p><a href="#" class="text-white-50 text-decoration-none d-block mb-2">Book Test</a></p>
                    <p><a href="#" class="text-white-50 text-decoration-none d-block mb-2">Contact</a></p>
                </div>

                <!-- Contact Info -->
                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h6 class="mb-4 fw-bold">Contact Info</h6>
                    <p class="text-white-50 mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Hinjewadi pune</p>
                    <p class="text-white-50 mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i>+91-7262026492</p>
@*                     <p class="text-white-50 mb-2"><i class="bi bi-envelope-fill text-primary me-2"></i>info@labcollect.com</p>
 *@                </div>

                <!-- Social Links -->
                <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mt-3">
                    <h6 class="mb-4 fw-bold">Follow Us</h6>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="btn btn-outline-light btn-floating rounded-circle" style="width: 40px; height: 40px;">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating rounded-circle" style="width: 40px; height: 40px;">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating rounded-circle" style="width: 40px; height: 40px;">
                            <i class="bi bi-twitter"></i>
                        </a>
                    </div>
                    <p class="text-white-50">Stay connected for health tips & updates.</p>
                </div>
            </div>

            <hr class="my-4 text-white-50" />

            <div class="row align-items-center">
                <div class="col-md-8 col-lg-8">
                    <p class="text-white-50 mb-0">© 2025 LabCollect Diagnostics. All rights reserved.</p>
                </div>
                <div class="col-md-4 col-lg-4 text-md-end">
                    <p class="text-white-50 mb-0">Designed by <span class="text-primary fw-semibold">LabCollect Team</span></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
