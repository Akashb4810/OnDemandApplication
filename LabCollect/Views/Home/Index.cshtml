<!-- Bootstrap Icons -->

<section id="features" class="py-5 bg-light">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6 text-primary mb-2">⚡ Key Features</h2>
            <p class="text-muted fs-5">Smart tools designed for modern laboratories & diagnostics</p>
        </div>

        <!-- Feature Cards -->
        <div class="row g-4">
            <!-- Feature 1 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100 text-center p-4">
                    <div class="icon-wrapper bg-primary bg-opacity-10 text-primary mx-auto mb-3">
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                    <h5 class="card-title fw-semibold text-dark">Inventory Management</h5>
                    <p class="card-text text-muted small mb-3">
                        Track chemicals, medicines, and equipment stock in real-time with automated alerts.
                    </p>
                    <a href="#" class="btn btn-outline-primary btn-sm rounded-pill px-3">Manage Inventory</a>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100 text-center p-4">
                    <div class="icon-wrapper bg-success bg-opacity-10 text-success mx-auto mb-3">
                        <i class="bi bi-cash-coin fs-1"></i>
                    </div>
                    <h5 class="card-title fw-semibold text-dark">Payments & Billing</h5>
                    <p class="card-text text-muted small mb-3">
                        Generate invoices, manage transactions, and simplify billing processes effortlessly.
                    </p>
                    <a href="#" class="btn btn-outline-success btn-sm rounded-pill px-3">View Payments</a>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100 text-center p-4">
                    <div class="icon-wrapper bg-warning bg-opacity-10 text-warning mx-auto mb-3">
                        <i class="bi bi-graph-up-arrow fs-1"></i>
                    </div>
                    <h5 class="card-title fw-semibold text-dark">Reports & Analytics</h5>
                    <p class="card-text text-muted small mb-3">
                        Analyze test data, track trends, and visualize performance with interactive reports.
                    </p>
                    <a href="#" class="btn btn-outline-warning btn-sm rounded-pill px-3 text-dark">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Custom CSS -->
<style>
    #features {
        background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
    }

    .feature-card {
        transition: all 0.4s ease;
        border-radius: 15px;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
        }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .feature-card:hover .icon-wrapper {
        transform: scale(1.1);
    }

    .card-title {
        font-size: 1.1rem;
    }
</style>

<!-- ABOUT SECTION -->
<section class="about-section py-5 bg-light position-relative">
    <div class="container text-center" style="padding: 3rem 0px;">
        <div class="mb-4">
            <img src="/images/lab.jpg" class="rounded-circle shadow-lg border border-3 border-white" width="150" height="150" alt="Lab System">
        </div>
        <h2 class="fw-bold text-primary mb-3">Why Choose Our System?</h2>
        <p class="text-muted mb-4 fs-5">
            Experience a secure, efficient, and user-friendly platform built exclusively for laboratories.
            Simplify your workflow — from patient management to payments — with powerful automation tools.
        </p>

        <div class="row justify-content-center gy-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-shield-lock-fill text-primary fs-1 mb-3"></i>
                        <h5 class="fw-semibold">Secure & Reliable</h5>
                        <p class="text-muted small">Your data is encrypted and always protected with top-grade security standards.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-speedometer2 text-success fs-1 mb-3"></i>
                        <h5 class="fw-semibold">Fast Performance</h5>
                        <p class="text-muted small">Lightning-fast operations ensure smooth data handling and reports.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-gear-wide-connected text-info fs-1 mb-3"></i>
                        <h5 class="fw-semibold">Easy Management</h5>
                        <p class="text-muted small">Manage patients, payments, and inventory — all from a single dashboard.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


