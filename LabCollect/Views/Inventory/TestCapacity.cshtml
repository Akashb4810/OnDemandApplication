@{
    ViewData["Title"] = "Test Capacity";
    if (User.IsInRole("Owner"))
    {
        Layout = "~/Views/_masterUserLayoutPage.cshtml";
    }
    else
    {
        Layout = "~/Views/_assistantLayoutPage.cshtml";
    }
}

@model System.Data.DataTable

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4 py-3">
            <h3 class="mb-0 fw-bold">
                🧪 Test Capacity
                <span class="badge bg-light text-primary ms-2">
                    TestId: @ViewBag.TestId
                </span>
            </h3>
        </div>

        <div class="card-body p-4">

            <table class="table table-hover table-bordered align-middle rounded-4 overflow-hidden shadow-sm">
                <thead class="table-dark">
                    <tr>
                        @foreach (System.Data.DataColumn col in Model.Columns)
                        {
                            <th class="fw-semibold">@col.ColumnName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.Rows)
                    {
                        <tr>
                            @foreach (System.Data.DataColumn col in Model.Columns)
                            {
                                <td>@row[col]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
