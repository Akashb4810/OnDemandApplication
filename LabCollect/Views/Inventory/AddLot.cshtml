@model LabCollect.Models.ReagentsLot

@{
    ViewData["Title"] = "Add Reagent Lot";
    var reagents = ViewBag.Reagents as List<LabCollect.Models.Reagent>;
    if (User.IsInRole("Owner"))
    {
        Layout = "~/Views/_masterUserLayoutPage.cshtml";
    }
    else 
    {
        Layout = "~/Views/_assistantLayoutPage.cshtml";
    }
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<h2 class="text-primary mb-4">
    <i class="bi bi-box-seam"></i> Add Reagent Lot
</h2>

<form method="post">

    <div class="mb-3">
        <label class="fw-bold">Lot Number</label>
        <input asp-for="LotNumber" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="fw-bold">Received Date</label>
        <input asp-for="ReceivedDate" type="date" class="form-control" required />
    </div>

    <hr />

    <h4 class="fw-bold text-secondary">Reagent Details</h4>

    <button type="button" class="btn btn-primary mb-3" id="addRowBtn">
        + Add Reagent Row
    </button>

    <table class="table table-bordered" id="reagentTable">
        <thead class="table-light">
            <tr>
                <th>Reagent</th>
                <th>Quantity</th>
                <th>Original Qty</th>
                <th>Tests/Unit</th>
                <th>Expiry</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <button class="btn btn-success px-4">Save Lot</button>
    <a href="/Inventory/ViewLots" class="btn btn-secondary px-4">Cancel</a>

</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    let rowIndex = 0;
    let reagents = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(reagents));

    $("#addRowBtn").click(function () {

        let options = reagents.map(r =>
            `<option value="${r.ReagentId}">${r.Name}</option>`).join("");

        let row = `
            <tr>
                <td>
                    <select name="Details[${rowIndex}].ReagentId" class="form-control">
                        ${options}
                    </select>
                </td>
                <td>
                    <input type="number" name="Details[${rowIndex}].Quantity" class="form-control"/>
                </td>
                <td>
                    <input type="number" name="Details[${rowIndex}].OriginalQuantity" class="form-control"/>
                </td>
                <td>
                    <input type="number" name="Details[${rowIndex}].TestsPerUnit" class="form-control"/>
                </td>
                <td>
                    <input type="date" name="Details[${rowIndex}].ExpiryDate" class="form-control"/>
                </td>
                <td>
                    <button type="button" class="btn btn-danger removeRow">X</button>
                </td>
            </tr>
        `;

        $("#reagentTable tbody").append(row);
        rowIndex++;
    });

    $(document).on("click", ".removeRow", function () {
        $(this).closest("tr").remove();
    });
</script>
