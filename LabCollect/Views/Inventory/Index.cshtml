@model IEnumerable<LabCollect.Models.ReagentIndexViewModel>
@{
    ViewBag.Title = "Reagent Inventory";
    if (User.IsInRole("Owner"))
    {
        Layout = "~/Views/_masterUserLayoutPage.cshtml";
    }
    else
    {
        Layout = "~/Views/_assistantLayoutPage.cshtml";
    }
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<!-- DataTable CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="d-flex justify-content-between mb-4">
    <h2 class="fw-bold text-primary">
        <i class="bi bi-droplet me-2"></i> Reagent Inventory
    </h2>

    <a href="/Inventory/AddReagent" class="btn btn-primary add-btn">
        <i class="bi bi-plus-circle"></i> Add Reagent
    </a>
</div>

<table id="reagentTable" class="table table-striped table-hover table-bordered shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>Name</th>
            <th>Unit</th>
            <th>Stock</th>
            <th>Tests Done</th>
            <th style="width:150px;">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.Name</td>
                <td>@item.Unit</td>

                <td>
                    @if (item.TotalQty <= item.LowStockLimit)
                    {
                        <span class="badge bg-danger">Low (@item.TotalQty)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@item.TotalQty</span>
                    }
                </td>

                <td>
                    <span class="badge bg-info text-dark">@item.TotalTestsDone</span>
                </td>

                <td>
                    <a href="/Inventory/ViewLots?reagentId=@item.ReagentId"
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-seam"></i> View Lots
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- DataTable JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#reagentTable').DataTable({
            "pageLength": 10,
            "lengthMenu": [5, 10, 20, 50],
            "order": [], // No default sorting
        });
    });
</script>

