@{
    ViewData["Title"] = "Add Reagent";
    if (User.IsInRole("Owner"))
    {
        Layout = "~/Views/_masterUserLayoutPage.cshtml";
    }
    else
    {
        Layout = "~/Views/_assistantLayoutPage.cshtml";
    }
}

@model Reagent

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
            <h3 class="mb-0 fw-bold">🧪 Add New Reagent</h3>
        </div>

        <div class="card-body p-4">

            <form method="post">
                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control shadow-sm", placeholder = "Enter reagent name" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Unit, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Unit, new { @class = "form-control shadow-sm", placeholder = "e.g. ml, mg, g" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.LowStockLimit, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.LowStockLimit, new { @class = "form-control shadow-sm", placeholder = "Enter alert threshold" })
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        💾 Save Reagent
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
