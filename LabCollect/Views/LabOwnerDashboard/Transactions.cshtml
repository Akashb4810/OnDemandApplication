@section Scripts {
    <script>
        // ✅ Select/Deselect all checkboxes (except disabled)
        document.getElementById("selectAll").addEventListener("change", function () {
            const checkboxes = document.querySelectorAll('input[name="selectedTransactionIds"]:not(:disabled)');
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateSelectedTotal();
        });

        // ✅ Listen for individual checkbox changes
        document.querySelectorAll('input[name="selectedTransactionIds"]:not(:disabled)').forEach(cb => {
            cb.addEventListener("change", updateSelectedTotal);
        });

        // ✅ Function to calculate total of selected rows
        function updateSelectedTotal() {
            let total = 0;
            document.querySelectorAll('input[name="selectedTransactionIds"]:checked').forEach(cb => {
                const row = cb.closest("tr");
                const paidText = row.querySelector("td:nth-child(12)").innerText.trim().replace(/[₹,]/g, '');
                const paidValue = parseFloat(paidText) || 0;
                total += paidValue;
            });

            document.getElementById("selectedTotal").innerText = "₹" + total.toFixed(2);
        }
    </script>
}
