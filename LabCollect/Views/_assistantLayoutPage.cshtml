@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@{
    var assistantName = HttpContextAccessor.HttpContext?.User?.FindFirst(ClaimTypes.Name)?.Value;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Assistant DashBoard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .table-responsive {
            overflow-x: scroll;
            -webkit-overflow-scrolling: touch;
        }

        .dashboard-header {
            font-weight: 700;
            font-size: 1.8rem;
            color: #0d6efd; /* Bootstrap Primary Blue */
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
            text-shadow: 0 1px 2px rgba(13, 110, 253, 0.2);
        }



      
        body {
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .container {
            flex: 1;
        }

        footer {
            margin-top: 0 !important;
            padding-bottom: 10px !important;
        }


    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(90deg, #4e54c8, #8f94fb); box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white">
                <i class="bi bi-person-circle me-2"></i>Hello @assistantName
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Index","Assistant")">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Dashboard","Assistant")">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Create","Payment")">
                            <i class="bi bi-person-plus me-1"></i> Add Patient
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Logout","Account")">
                            <i class="bi bi-box-arrow-right me-1"></i> Log Out
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Add Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">


    <!-- Main content -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 ">
        <div class="container text-center">
            <p class="mb-1">&copy; @DateTime.Now.Year <strong>SmartLab Manager</strong>. All Rights Reserved.</p>
            <small class="text-secondary">
                Designed & Developed by <a href="#" class="text-decoration-none text-info"></a>
            </small>
        </div>
    </footer>

    <!-- Scripts -->
    <!-- 1. jQuery core (must be first!) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 2. jQuery UI -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <!-- 3. jQuery Validate -->
    @* // <script src="https://cdn.jsdelivr.net/jquery.validation/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.19.5/additional-methods.min.js"></script>*@

    <!-- 4. Bootstrap bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Render page scripts -->
    @RenderSection("Scripts", required: false)
</body>
</html>
