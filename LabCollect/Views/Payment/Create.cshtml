@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- jQuery (required for Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // ✅ Initialize Select2
        $(document).ready(function () {
                    $('#testSelect').select2({
            theme: 'bootstrap-5',
            placeholder: 'Search and select tests',
            allowClear: true,
            closeOnSelect: false,
            minimumResultsForSearch: 0,
            sorter: function(data) {
                return data.slice(0, 10); // show only 10 items at once
            }
        });
        });

        const testSelect = $('#testSelect');
        const selectedTestsTable = document.querySelector("#selectedTestsTable tbody");
        const hiddenInputs = document.getElementById("hiddenTestInputs");
        const totalAmountField = document.getElementById("TotalAmount");
        let selectedTests = [];

        testSelect.on('change', function () {
            selectedTests = [];
            selectedTestsTable.innerHTML = '';
            hiddenInputs.innerHTML = '';

            const selectedOptions = $(this).find('option:selected');
            selectedOptions.each(function () {
                const testId = $(this).val();
                const testName = $(this).text();
                const price = parseFloat($(this).attr('data-price')) || 0;

                selectedTests.push({ id: testId, name: testName, price: price });

                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${testName}</td>
                    <td>₹${price.toFixed(2)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger remove-test" data-id="${testId}">
                        <i class="bi bi-x"></i></button></td>
                `;
                selectedTestsTable.appendChild(row);

                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "SelectedTestIds";
                input.value = testId;
                input.dataset.testId = testId;
                hiddenInputs.appendChild(input);
            });

            updateTotal();
        });

        // 🗑 Remove test from table and dropdown
        selectedTestsTable.addEventListener("click", function (e) {
            if (e.target.closest(".remove-test")) {
                const id = e.target.closest(".remove-test").dataset.id;
                const option = testSelect.find(`option[value='${id}']`);
                option.prop('selected', false);
                testSelect.trigger('change');
            }
        });

        function updateTotal() {
            let total = selectedTests.reduce((sum, t) => sum + t.price, 0);
            totalAmountField.value = total.toFixed(2);
            calculateAmount();
        }

        function calculateAmount() {
            let total = parseFloat(document.getElementById("TotalAmount").value) || 0;
            let discount = parseFloat(document.getElementById("DiscountAmount").value) || 0;
            let finalAmount = total - discount;
            if (finalAmount < 0) finalAmount = 0;
            document.getElementById("Amount").value = finalAmount.toFixed(2);
        }

        document.getElementById("TotalAmount").addEventListener("input", calculateAmount);
        document.getElementById("DiscountAmount").addEventListener("input", calculateAmount);

        // 🌀 Loading button effect
        document.querySelector("form").addEventListener("submit", function () {
            const btn = document.getElementById("btnSubmit");
            const btnText = document.getElementById("btnText");
            const btnLoader = document.getElementById("btnLoader");
            btn.disabled = true;
            btnText.textContent = "Saving...";
            btnLoader.classList.remove("d-none");
        });

                   document.querySelector("form").addEventListener("submit", function (e) {

            const form = this;

            // Wait a moment — .NET MVC injects validation errors in DOM
            setTimeout(function () {
                const hasErrors = document.querySelectorAll(".field-validation-error").length > 0;

                const btn = document.getElementById("btnSubmit");
                const btnText = document.getElementById("btnText");
                const btnLoader = document.getElementById("btnLoader");

                if (hasErrors) {
                    // ❌ Validation failed
                    btn.disabled = false;
                    btnText.innerHTML = '<i class="bi bi-save me-1"></i> Save Payment';
                    btnLoader.classList.add("d-none");
                } else {
                    // ✔ No errors → submit normally
                    btn.disabled = true;
                    btnText.textContent = "Saving...";
                    btnLoader.classList.remove("d-none");
                }
            }, 150); // Wait for validation message to appear
        });

        // ✅ Prevent SampleId = 0
        const sampleIdInput = document.getElementById("SampleId");
        sampleIdInput.addEventListener("input", function () {
            const value = parseInt(sampleIdInput.value) || 0;
            if (value === 0) {
                alert("❌ Sample ID cannot be 0. Please enter a valid ID.");
                sampleIdInput.value = "";
            }
        });

             // ✅ Auto-set status to "Paid" if PaidAmount == Amount
        const paidAmountInput = document.querySelector("input[name='PaidAmount']");
        const amountInput = document.getElementById("Amount");
        const statusSelect = document.querySelector("select[name='Status']");

        function updatePaymentStatus() {
            const amount = parseFloat(amountInput.value) || 0;
            const paid = parseFloat(paidAmountInput.value) || 0;

            if (paid === amount && amount > 0) {
                statusSelect.value = "Paid";
            } else if (paid < amount && paid > 0) {
                statusSelect.value = "Unpaid";
            } else {
                statusSelect.value = "";
            }
        }

        paidAmountInput.addEventListener("input", updatePaymentStatus);
        amountInput.addEventListener("input", updatePaymentStatus);

        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const preview = document.getElementById('ImagePreview');
                preview.src = reader.result;
                preview.classList.remove("d-none");
            }
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}
