@model LabCollect.Models.PaymentTransactionViewModel
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/_assistantLayoutPage.cshtml";
}


<div class="container mt-5" style="max-width:500px;">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="text-center mb-4 text-primary fw-bold">💰 Add Payment</h3>

            @if (ViewBag.Message != null)
            {
                <div class="alert @(ViewBag.Message.Contains("Failed") ? "alert-danger" : "alert-success")">
                    @ViewBag.Message
                </div>
            }

            <form asp-action="Update" method="post">
                <div class="mb-3">
                    <label asp-for="PaymentId" class="form-label fw-semibold">PaymentId ID</label>
                    <input asp-for="PaymentId" class="form-control" placeholder="Enter Payment ID" />
                    <span asp-validation-for="PaymentId" class="text-danger"></span>
                </div>
                @* <input type="hidden" asp-for="DiscountAmount" id="FinalDiscount" /> *@
<input type="hidden" asp-for="RemaingAmount" id="OriginalRemaining" />
<input type="hidden" asp-for="FinalDiscountAmount" id="FinalDiscountAmount" />

                <div class="mb-3">
                    <label asp-for="PaidAmount" class="form-label fw-semibold">Remaining Payment: @Model.RemaingAmount</label>
                </div>
                <!-- Actual Discount -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-success">
                        Actual Discount: <span id="actualDiscount">@Model.DiscountAmount</span>
                    </label>
                </div>

                <!-- Add New Discount -->
                <div class="mb-3">
                    <label asp-for="DiscountAmount" class="form-label fw-semibold">Discount Amount</label>
                    <input asp-for="DiscountAmount" class="form-control" id="discountInput" placeholder="Enter Amount" />
                </div>

                <!-- Updated Remaining After Discount -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-primary">
                        Updated Remaining Amount: <span id="updatedRemaining">@Model.RemaingAmount</span>
                    </label>
                </div>
                <div class="mb-3">
                    <label asp-for="PaidAmount" class="form-label fw-semibold">Amount</label>
                    <input asp-for="PaidAmount" class="form-control" placeholder="Enter Amount" />
                    <span asp-validation-for="PaidAmount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="">-- Select --</option>
                        <option value="Cash">Cash</option>
                        <option value="Online">Online</option>
                        <option value="CashLess">Cash Less</option>
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label fw-semibold">Note </label>
                    <input asp-for="Notes" class="form-control" placeholder="Enter Note" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2">💾 Save Payment</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const initialRemaining = parseFloat("@Model.RemaingAmount") || 0;
            const initialActualDiscount = parseFloat("@Model.DiscountAmount") || 0;

            const discountInput = document.querySelector("#discountInput");
            const actualDiscountLabel = document.querySelector("#actualDiscount");
            const updatedRemainingLabel = document.querySelector("#updatedRemaining");

            // FOR PAID AMOUNT VALIDATION
            const paidAmountInput = document.querySelector("#PaidAmount");

            // Update Discount + Remaining dynamically
            discountInput.addEventListener("input", function () {
                const newDiscount = parseFloat(discountInput.value) || 0;

                // New total discount = old + new input
                const totalDiscount = initialActualDiscount + newDiscount;
                actualDiscountLabel.innerText = totalDiscount.toFixed(2);
                     finalDiscountHidden.value = totalDiscount.toFixed(2);
                // Update remaining
                let newRemaining = initialRemaining - newDiscount;
                if (newRemaining < 0) newRemaining = 0;

                updatedRemainingLabel.innerText = newRemaining.toFixed(2);
            });
                const finalDiscountHidden = document.querySelector("#FinalDiscountAmount");
            // Prevent paid > remaining
            paidAmountInput.addEventListener("input", function () {
                const updatedRemaining = parseFloat(updatedRemainingLabel.innerText) || 0;
                const paidAmount = parseFloat(paidAmountInput.value) || 0;

                if (paidAmount > updatedRemaining) {
                    const alertDiv = document.createElement("div");
                    alertDiv.className = "alert alert-danger mt-2";
                    alertDiv.innerText = "❌ Paid amount cannot be greater than remaining amount.";

                    const existingAlert = document.querySelector(".alert-danger");
                    if (existingAlert) existingAlert.remove();

                    paidAmountInput.parentNode.appendChild(alertDiv);
                    paidAmountInput.value = "";
                } else {
                    const existingAlert = document.querySelector(".alert-danger");
                    if (existingAlert) existingAlert.remove();
                }
                    document.querySelector("#FinalDiscount").value = totalDiscount.toFixed(2);
        document.querySelector("#OriginalRemaining").value = newRemaining.toFixed(2);
            });

        });
    </script>
}
